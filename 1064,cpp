#include <iostream>
#include <iomanip>

using namespace std;

int main(){

    double a,ints;
    int incremento;
    incremento = 0;

    for (int i = 0; i < 6; i++)
    {
        cin>>a;
        if (a>0)
        {
            ints = ints + a;
            incremento++;
            
        }
        
